{
  "targets": {
    "format": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "prettier --write . --ignore-path .prettierignore --ignore-unknown",
          "nx run-many -t lint-fix -p analyzer ingestor query-service py-common --parallel",
          "nx run-many -t format -p analyzer ingestor query-service py-common --parallel"
        ],
        "parallel": false
      },
      "outputs": []
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check . --ignore-path .prettierignore --ignore-unknown"
      }
    },
    "verify": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m unittest discover -s tools/tests -p \"test_*.py\"",
        "cwd": "{workspaceRoot}"
      },
      "outputs": []
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "concurrently --names \"PLATFORM,ANALYZER,INGESTOR,QUERY,CONSOLE\" --prefix \"[{name}]\" --prefix-colors \"blue,green,magenta,cyan,yellow\" \"nx run platform:serve --configuration=dev\" \"nx run analyzer:serve-hmr -- --port 8000\" \"nx run ingestor:serve-hmr -- --port 8001\" \"nx run query-service:serve-hmr -- --port 8002\" \"nx run omni-console:serve -- --port 5173\""
      }
    },
    "docker-dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "git submodule sync",
          "git submodule update --init --recursive",
          "docker compose up --build"
        ],
        "parallel": false
      }
    },
    "docker-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose down"
      }
    },
    "docker-logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose logs -f {args.service}"
      }
    },
    "docker-restart": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose restart {args.service}"
      }
    },
    "init": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "git submodule sync",
          "git submodule update --init --recursive",
          "docker compose up -d"
        ],
        "parallel": false
      }
    }
  }
}
