# Shared local development environment for Omni apps.
# Copy this file to .env and adjust values for your machine.

# Python I/O encoding - UTF-8 prevents UnicodeEncodeError on Windows
# when third-party libraries (e.g., vnstock promotional display) print emojis
PYTHONIOENCODING=utf-8

APP_ENV=dev
SPRING_PROFILES_ACTIVE=dev

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omni
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omni
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/omni
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

ANALYZER_BASE_URL=http://localhost:8000

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=stock-data

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stock-data

APP_SCHEDULER_ZONE=Asia/Ho_Chi_Minh
APP_SCHEDULER_INSTANCE_ID=
APP_SCHEDULER_CLAIM_LEASE_DURATION=PT2M
APP_SCHEDULER_CLAIM_BATCH_SIZE=10

# Shared system/operator UUID for backend/console triggers and auditing
SYSTEM_OPERATOR_UUID=b252fe62-80f3-4df9-9734-5dc549705a25
# Comma-separated definition UUIDs or exact JOB_TYPE:SOURCE identities.
# Empty means manual triggering is disabled.
# IMPORTANT: Use the canonical Spring property key (not the SCREAMING_SNAKE_CASE
# alias) so Spring Boot's relaxed binding splits the comma list into List<String>.
# A YAML ${ENV_VAR:} placeholder resolves to a single string and is never split.
app.scheduler.manual-trigger.allow-list=
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATIONS_CHAT_ID=
TELEGRAM_SIGNALS_CHAT_ID=
SIGNAL_NOTIFICATIONS_CONSUMER_GROUP=platform-signal-notifications-v1
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_DISPLAY_TIME_ZONE=Asia/Bangkok
TELEGRAM_AUDIBLE_OPERATIONAL_ERRORS=true

# Telegram Signal Notification Filters
# Allowed strategies (comma-separated, defaults to CONFIRMED_TREND_EQUALS)
# Example: CONFIRMED_TREND_EQUALS,TREND_MOMENTUM_V1,ICHIMOKU_V1
TELEGRAM_SIGNAL_FILTER_ALLOWED_STRATEGIES=CONFIRMED_TREND_EQUALS
# Allowed symbols (comma-separated, empty = all symbols)
# Example: HOSE-FPT,HOSE-VNM,HNX-ACB
TELEGRAM_SIGNAL_FILTER_ALLOWED_SYMBOLS=
# Symbol patterns using glob syntax (comma-separated, empty = no patterns)
# Example: HOSE-*,HNX-*
TELEGRAM_SIGNAL_FILTER_SYMBOL_PATTERNS=
# Allowed signal directions (comma-separated, empty = all directions)
# Example: BUY,SELL (excludes HOLD)
TELEGRAM_SIGNAL_FILTER_ALLOWED_DIRECTIONS=
# Allowed timeframes (comma-separated, empty = all timeframes)
# Example: 1d,4h
TELEGRAM_SIGNAL_FILTER_ALLOWED_TIMEFRAMES=
# Minimum score threshold (empty = no threshold)
# Example: 0.7 (only signals with score >= 0.7)
TELEGRAM_SIGNAL_FILTER_MIN_SCORE=
# Enable newSignalDate eligibility for daily confirmed results
TELEGRAM_SIGNAL_FILTER_ENABLE_NEW_SIGNAL_DATE=true
