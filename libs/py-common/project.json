{
  "name": "py-common",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/py-common",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check py_common tests && uv run ruff format --check py_common tests",
        "cwd": "libs/py-common"
      }
    },
    "lint-fix": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff format py_common tests && uv run ruff check --fix py_common tests",
        "cwd": "{projectRoot}"
      },
      "outputs": []
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff format py_common tests",
        "cwd": "libs/py-common"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "libs/py-common"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv build",
        "cwd": "libs/py-common"
      }
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv lock",
        "cwd": "libs/py-common"
      }
    },
    "sync": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv sync",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      }
    }
  },
  "tags": ["type:library", "scope:shared", "lang:python"]
}
