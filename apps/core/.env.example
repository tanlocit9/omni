# Optional platform-only overrides.
# Values here override the shared root .env when loaded by Docker Compose.

SPRING_PROFILES_ACTIVE=dev

# Telegram delivery cooldown is per platform instance.
TELEGRAM_DEDUPLICATION_COOLDOWN=PT5M
TELEGRAM_DEDUPLICATION_MAX_CACHE_SIZE=10000
TELEGRAM_DISPLAY_TIME_ZONE=Asia/Bangkok
TELEGRAM_AUDIBLE_OPERATIONAL_ERRORS=true
