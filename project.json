{
  "targets": {
    "dev": {
      "dependsOn": [
        "init"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "concurrently --names \"JAVA,ANALYZER,INGESTOR\" --prefix \"[{name}]\" --prefix-colors \"blue,green,magenta\" \"nx serve platform --configuration=dev\" \"nx serve analyzer\" \"nx serve ingestor\""
      }
    },
    "docker-dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "git submodule sync",
          "git submodule update --init --recursive",
          "docker compose up --build"
        ],
        "parallel": false
      }
    },
    "docker-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose down"
      }
    },
    "docker-logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose logs -f {args.service}"
      }
    },
    "docker-restart": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose restart {args.service}"
      }
    },
    "init": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "git submodule sync",
          "git submodule update --init --recursive",
          "docker compose -f docker-compose.infra.yaml up -d"
        ],
        "parallel": false
      }
    }
  }
}