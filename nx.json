{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": true,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/src/test/**/*"],
    "sharedGlobals": []
  },
  "nxCloudId": "6a77315e5ba40e8bff0fb8b4",
  "nxIgnorePatterns": [
    "out",
    "examples",
    "docs",
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**"
  ],
  "plugins": [
    {
      "options": {
        "build": {
          "buildDepsName": "build-deps",
          "configName": "tsconfig.lib.json",
          "targetName": "build",
          "watchDepsName": "watch-deps"
        },
        "typecheck": {
          "targetName": "typecheck"
        }
      },
      "plugin": "@nx/js/typescript"
    },
    {
      "exclude": ["apps/core/gradlew.bat"],
      "options": {
        "buildTargetName": "build",
        "classesTargetName": "classes",
        "testTargetName": "test"
      },
      "plugin": "@nx/gradle"
    },
    {
      "options": {
        "inferDependencies": true,
        "packageManager": "uv"
      },
      "plugin": "@nxlv/python"
    }
  ],
  "sync": {
    "applyChanges": true
  },
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  }
}
