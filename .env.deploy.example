# Shared deployment environment for Omni apps.
# Copy this file to .env on the deployment host and replace secrets.

APP_ENV=prod
SPRING_PROFILES_ACTIVE=prod

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=omni
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/omni
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/omni
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME=stock-data

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=stock-data

APP_SCHEDULER_ZONE=Asia/Ho_Chi_Minh
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=html
TELEGRAM_API_BASE_URL=https://api.telegram.org
