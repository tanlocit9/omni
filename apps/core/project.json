{
  "name": "platform",
  "root": "apps/core",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradlew bootRun",
        "cwd": "{projectRoot}"
      }
    }
  },
  "build": {
    "executor": "nx:run-commands",
    "options": {
      "command": "gradlew build --continuous",
      "cwd": "{projectRoot}"
    }
  }
}